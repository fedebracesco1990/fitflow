# FitFlow environment variables
# Copy this file to .env (in the repo root) and fill in the values.
# The root .env is read by docker-compose and by the backend.

# --- MySQL container (docker-compose) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fit_flow_db
MYSQL_USER=devuser
MYSQL_PASSWORD=change-me

# --- Backend: database connection (must match the MySQL values above) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=devuser
DB_PASSWORD=change-me
DB_DATABASE=fit_flow_db
# Use SSL for the database connection (managed databases in production)
DB_SSL=false
# Create/update tables from the entities on startup (development only)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Backend: application ---
# development | production | test (the seed with test users only runs outside production)
NODE_ENV=development
PORT=3000
# Used to build links sent by email (password reset)
FRONTEND_URL=http://localhost:4200
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:4200

# --- Backend: JWT ---
# Required, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Lifetimes in seconds (45 min / 7 days)
JWT_ACCESS_TOKEN_EXPIRATION=2700
JWT_REFRESH_TOKEN_EXPIRATION=604800

# --- Backend: access QR codes ---
# Optional: falls back to JWT_SECRET if empty
QR_JWT_SECRET=
QR_JWT_EXPIRES_IN=365d

# --- Backend: push notifications (Firebase service account) ---
# Optional: without them push notifications are disabled.
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as they appear in the JSON key
FIREBASE_PRIVATE_KEY=

# --- Backend: email (password reset) ---
# Development: Mailpit from docker-compose (web UI at http://localhost:8025).
# Production: any SMTP provider. Leave SMTP_HOST empty to only log emails.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FitFlow <no-reply@fitflow.local>
